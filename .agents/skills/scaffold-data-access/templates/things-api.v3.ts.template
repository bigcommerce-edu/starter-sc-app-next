// Uncached counterpart, for Server Actions: they must read current state
// before mutating, never a cached copy. CACHE_PROFILE_NONE also forces
// no-store under the fetch-level cache implementation.
export async function fetchThingUncached(id: number | string, storeHash: string | undefined): Promise<Thing> {
  const apiClient = await getRestApiClient(storeHash);
  const { data: body } = await apiClient.get<V3SingleResponse<ThingWireRecord>>(getThingPath(id), {
    cache: { profile: CACHE_PROFILE_NONE },
  });

  return parseThing(body.data);
}

// ===== Mutations =====
// Never cached. Not supported in MOCK mode (MockRestApiClient rejects
// post/put/delete). Callers (Server Actions) handle authorization, error
// messages, and updateTag() invalidation — not this layer.

// Fields a create/update request may send, in wire format.
export type ThingInput = Partial<Omit<ThingWireRecord, "id">>;

export async function createThing(input: ThingInput, storeHash: string | undefined): Promise<Thing> {
  const apiClient = await getRestApiClient(storeHash);
  const { data: body } = await apiClient.post<V3SingleResponse<ThingWireRecord>>(THINGS_PATH, {
    body: input,
  });

  return parseThing(body.data);
}

// Check the endpoint's semantics: some v3 PUTs are partial updates of one
// record (as here), others are bulk endpoints taking an array keyed by id and
// returning a list — e.g. /v3/customers.
export async function updateThing(
  id: number | string,
  input: ThingInput,
  storeHash: string | undefined,
): Promise<Thing> {
  const apiClient = await getRestApiClient(storeHash);
  const { data: body } = await apiClient.put<V3SingleResponse<ThingWireRecord>>(getThingPath(id), {
    body: input,
  });

  if (!body?.data) {
    throw new AppError("NOT_FOUND", "The record could not be found.", {
      cause: `No thing returned for id "${id}" after a PUT.`,
    });
  }

  return parseThing(body.data);
}

// DELETE typically responds 204 No Content, so there's nothing to parse.
export async function deleteThing(id: number | string, storeHash: string | undefined): Promise<void> {
  const apiClient = await getRestApiClient(storeHash);

  await apiClient.delete(getThingPath(id));
}
