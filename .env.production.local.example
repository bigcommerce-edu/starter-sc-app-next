# Holds build-time vars read by next.config.ts, which wrangler.jsonc's `vars`
# can't reach — those only populate the deployed Worker's runtime env, after
# the build. Applies to both `pnpm preview` and `pnpm deploy`, since each runs
# `next build` in production mode. Keep the `.local` suffix: `.env.production`
# sits below .env.local in Next's load order.

# Selects which credentials-store driver survives the build; every other
# driver is stubbed out (see next.config.ts). Must be D1 for Workers, and must
# match CREDENTIALS_STORE_DRIVER in wrangler.jsonc's `vars`, which is what the
# deployed Worker reads at runtime.
CREDENTIALS_STORE_DRIVER=D1
