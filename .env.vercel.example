# Generated by `pnpm scaffold vercel` from .env.example — see that file for
# anything not called out below. Re-run the scaffold command any time to
# pick up new vars added to .env.example since (it won't overwrite this
# file if it already exists, so remove it first if you want a fresh copy).
#
# This is a reference for what to set in Vercel's dashboard (Project
# Settings > Environment Variables) — Vercel doesn't read this file itself.

# BigCommerce OAuth app credentials (Dev Portal > your app > OAuth)
BIGCOMMERCE_CLIENT_ID=
BIGCOMMERCE_CLIENT_SECRET=

# The app's own public origin (e.g. https://my-app.example.com). Used to
# build the OAuth redirect_uri sent to BigCommerce and this app's own
# browser-facing redirects — never derived from the incoming request, since
# behind a proxy or on Cloudflare the request's observed host/scheme isn't
# guaranteed to match the public origin BigCommerce actually calls back to.
APP_ORIGIN=

# Secret used to sign/verify this app's own session cookie (not to be
# confused with BIGCOMMERCE_CLIENT_SECRET, which verifies BigCommerce's
# inbound signed_payload_jwt — a different trust boundary).
SESSION_SECRET=

# Developer branding shown in the app shell's support panel.
# Filename of the logo image, expected to be in the public/ directory.
DEVELOPER_LOGO_FILENAME=northlight-logo.svg
DEVELOPER_NAME="Northlight Apps"
SUPPORT_EMAIL=support@northlightapps.dev
SUPPORT_URL=https://northlightapps.dev/support
SUPPORT_PHONE="+1 (555) 010-0142"

# Production mode: looks up each store's API token from durable storage
# based on the authenticated session, rather than MOCK's in-memory data or
# STATIC's single hardcoded token. See the comment above this var for the
# full list of DATA_MODE values.
DATA_MODE=MULTITENANT

# Set to "true" to enable Next.js Cache Components caching for API data.
# Anything else leaves caching off, as does omitting the var entirely — the
# app's fallback when it's undefined is off, so caching is only ever on
# because something opted in. It's set to TRUE here because caching is one of
# the patterns this app exists to demonstrate, and leaving it on out of the
# box is what makes that behavior visible; pair it with LOG_API_REQUESTS
# below to watch cache hits and misses, since an upstream request is only
# logged on a miss.
#
# Set it to FALSE to turn caching off. Consider doing that when working on
# anything where stale reads would confuse you, and think carefully about
# whether you want it on in a real deployment: this is an admin-privileged
# app, and stale data is often the worse trade-off. The app's own mutations
# invalidate what they change, but updates made elsewhere (a gift certificate
# purchased on the storefront, an edit in the BigCommerce control panel)
# won't appear until the cache lifetime expires.
#
# NOTE that in the case of cacheComponents, disabling cache works by using
# zero-second profiles, since cacheComponents itself can't be disabled by
# environment config.
CACHE_ENABLED=TRUE

# Set to "true" to log every outgoing BigCommerce API request (method, URL,
# status, duration) to the console. Off by default. Since a request only
# ever fires on a `use cache` miss, this also serves as a cache-observability
# signal: a logged request means a miss just occurred, and no log on a
# repeat page load means it was served from cache.
LOG_API_REQUESTS=FALSE

# Selects the Postgres credentials-store driver (see
# src/lib/credentials-store/postgres-driver/) over the SQLITE default —
# required for MULTITENANT on Vercel, since SQLite's local-file model
# doesn't survive Vercel's ephemeral, multi-instance filesystem.
CREDENTIALS_STORE_DRIVER=POSTGRES

# ===== POSTGRES SETTINGS =====
# Required when CREDENTIALS_STORE_DRIVER=POSTGRES. A plain libpq connection
# string — works with Neon or any standard Postgres server, not just Neon.
# Provisioned automatically if you add the Vercel Postgres (Neon)
# integration from your project's Storage tab; otherwise set it to your
# own Postgres server's connection string.
# Example: postgres://user:password@host/dbname?sslmode=verify-full
DATABASE_URL=

# Used only by `pnpm db:postgres:migrate` (see scripts/postgres/migrate.mjs)
# to run schema migrations against the *unpooled* (non-PgBouncer)
# connection — not read by the app itself at request time. Provisioned
# automatically alongside DATABASE_URL by the Vercel Postgres (Neon)
# integration. If unset, the migrate script falls back to DATABASE_URL.
# Example: postgres://user:password@host/dbname?sslmode=verify-full
DATABASE_URL_UNPOOLED=

# Caps how many concurrent Postgres connections this app's pool opens per
# warm serverless instance (see postgres-driver/get-pool.ts). Defaults to
# node-postgres's own default (10) if unset, which is fine against a pooled
# endpoint like Neon's (PgBouncer fans concurrent queries in below that),
# but against a plain, unpooled Postgres server, that many connections per
# instance can exhaust the server's own connection limit (~100 by default)
# once several instances are warm at once — lower this (e.g. to 2-5) in
# that case.
# DATABASE_POOL_MAX=10

# Symmetric key used to encrypt stored store access tokens at rest
CREDENTIALS_ENCRYPTION_KEY=

# Set to "false" to disable this app's own error logging (caught DB/upstream
# API failures, install/auth failures, etc. — see lib/errors/logger.ts).
# Logging is ON by default since it's how an operator notices a real
# production failure; only disable it if you're piping console.error
# somewhere unwanted or a platform bills per log line.
ERROR_LOGGING_ENABLED=TRUE
