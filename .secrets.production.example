# Holds vars that are sensitive, or whose value differs per deployed
# environment. Non-sensitive vars that are the same everywhere go in
# wrangler.jsonc's `vars` instead, which is committed in plaintext. See
# .env.example for what each var does; mirror any addition here in
# wrangler.jsonc's `secrets.required`.

BIGCOMMERCE_CLIENT_ID=
BIGCOMMERCE_CLIENT_SECRET=

# e.g. https://starter-sc-app-next.example.workers.dev
APP_ORIGIN=

SESSION_SECRET=
CREDENTIALS_ENCRYPTION_KEY=

STATIC_STORE_HASH=
STATIC_STORE_TOKEN=
