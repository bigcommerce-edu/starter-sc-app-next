import { getCloudflareContext } from "@opennextjs/cloudflare";
import { D1CredentialsStore } from "@/lib/credentials-store/d1-driver/d1-credentials-store";
import { CredentialsStore } from "@/lib/credentials-store/types";

// Builds a D1CredentialsStore around the Worker's D1 binding.
//
// Installed over src/lib/credentials-store/d1-driver-loader.ts by
// `pnpm scaffold cloudflare`, replacing the core version that throws. The
// driver itself is portable and unchanged; this file is the only part that
// knows where the database handle comes from.
//
// Must match the binding declared in wrangler.jsonc's d1_databases. Unlike the
// OpenNext cache bindings, this name is the app's own.
const D1_BINDING_NAME = "CREDENTIALS_D1";

// A lookup, not a connection — a D1 binding arrives ready to use, so there's
// nothing to pool. It is deliberately not cached across calls either: the
// binding belongs to the current request's env. Per-request memoization of the
// store instance already happens in get-credentials-store.ts.
//
// The synchronous form of getCloudflareContext() is safe here because every
// caller is already inside a request.
//
// Schema is applied by `wrangler d1 migrations apply` (see
// d1-driver/migrations/) before deploy; the driver assumes it exists.
export function createD1CredentialsStore(): CredentialsStore {
  const database = getCloudflareContext().env[D1_BINDING_NAME];

  if (!database) {
    throw new Error(
      `The ${D1_BINDING_NAME} binding is not available. It must be declared in wrangler.jsonc's ` +
        "d1_databases to use the D1 credentials store driver, and is only present when running on " +
        "Cloudflare Workers (`pnpm preview`/`pnpm deploy`), not under `next dev`.",
    );
  }

  return new D1CredentialsStore(database);
}
