{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "starter-sc-app-next",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": [
    // Enable Node.js API
    // see https://developers.cloudflare.com/workers/configuration/compatibility-flags/#nodejs-compatibility-flag
    "nodejs_compat",
    // Allow to fetch URLs in your app
    // see https://developers.cloudflare.com/workers/configuration/compatibility-flags/#global-fetch-strictly-public
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Non-sensitive settings that are the same for any deployment of this app.
  // These are committed and served in plaintext, so nothing sensitive and
  // nothing environment-specific belongs here — that goes in
  // .secrets.production instead (see .secrets.production.example for the split).
  //
  // Values here are the defaults a fresh deploy starts from, not a
  // production-only profile: DATA_MODE in particular is expected to move
  // MOCK -> STATIC -> MULTITENANT as an app is built out.
  "vars": {
    // How the app sources data. MOCK here so a fresh deploy comes up working
    // with in-memory fixtures, no BigCommerce credentials, and no external
    // requests. The two other values are prototyping/production steps:
    //   STATIC      - every request uses the single store token in
    //                 STATIC_STORE_HASH/STATIC_STORE_TOKEN (see
    //                 .secrets.production.example) — one real store, not multi-user.
    //   MULTITENANT - production: tokens looked up per-user from durable
    //                 storage based on the authenticated session.
    "DATA_MODE": "MOCK",
    // Simulates network latency on every MOCK-mode request so loading and
    // Suspense states stay visible in a deployed demo — the same reason
    // .env.example sets them for local dev. Each request waits a random
    // number of ms in this range.
    //
    // Commented out because absent vars mean no delay (see
    // getMockRequestDelayRangeMs in
    // src/lib/bc-api-client/rest-client/mock-rest-client/mock-rest-client.ts),
    // which is the right default for a deployed environment. Uncomment both
    // to opt in — the delay only applies if both parse as finite numbers with
    // 0 <= MIN <= MAX, so setting just one leaves it off. Unread outside
    // DATA_MODE=MOCK, so these can stay as-is once you move to STATIC or
    // MULTITENANT.
    // "MOCK_REQUEST_DELAY_MIN_MS": "500",
    // "MOCK_REQUEST_DELAY_MAX_MS": "2000",
    // Cache Components caching for API data. On here because caching is one
    // of the patterns this app exists to demonstrate; see
    // src/lib/cache/cache-profiles.ts and docs/ARCHITECTURE.md.
    "CACHE_ENABLED": "TRUE",
    // Logs every outgoing BigCommerce API request (method, URL, status,
    // duration). Off by default — it's a developer diagnostic, and it does
    // nothing in MOCK mode anyway, since no upstream request is ever made.
    // Turn it on alongside CACHE_ENABLED in STATIC/MULTITENANT to watch cache
    // behavior: a logged request means a `use cache` miss just occurred.
    "LOG_API_REQUESTS": "FALSE",
    // This app's own error logging for caught DB/upstream failures. On, since
    // it's how an operator notices a real production failure.
    "ERROR_LOGGING_ENABLED": "TRUE",
    // Which driver backs credentials storage. SQLITE for now, which is also
    // the app's fallback when this is unset or invalid (see
    // getConfiguredDriver in
    // src/lib/credentials-store/get-credentials-store.ts).
    //
    // Note this is only reached in MULTITENANT mode — MOCK and STATIC never
    // look up a stored credential — so with DATA_MODE=MOCK above, the value
    // here doesn't affect request handling yet.
    //
    // It does still matter at build time: next.config.ts aliases the Postgres
    // driver to a `pg`-free stub whenever this isn't "POSTGRES", and that
    // alias is what keeps `pg`'s unconditional require("pg-cloudflare") out
    // of the Workers bundle. Setting this to POSTGRES would pull `pg` back in
    // and break the build for this target. The D1 driver this project is
    // moving toward will become the real value here.
    "CREDENTIALS_STORE_DRIVER": "SQLITE",
    // Developer branding shown in the app shell's support panel. Public-facing
    // by definition, and the same across this app's deployments.
    "DEVELOPER_LOGO_FILENAME": "northlight-logo.svg",
    "DEVELOPER_NAME": "Northlight Apps",
    "SUPPORT_EMAIL": "support@northlightapps.dev",
    "SUPPORT_URL": "https://northlightapps.dev/support",
    "SUPPORT_PHONE": "+1 (555) 010-0142"
  },
  // Mirrors the var names in .secrets.production (see .secrets.production.example).
  // Declaring them here drives type generation and makes a missing secret a
  // local-dev warning rather than a runtime failure after deploy. Adding a
  // secret means adding it in both places.
  "secrets": {
    "required": [
      "BIGCOMMERCE_CLIENT_ID",
      "BIGCOMMERCE_CLIENT_SECRET",
      "APP_ORIGIN",
      "SESSION_SECRET",
      "CREDENTIALS_ENCRYPTION_KEY",
      // Only read when DATA_MODE is STATIC, but listed here because
      // `wrangler secret bulk` uploads them as empty secrets in the other
      // modes — so the bindings exist either way. Drop them from this list if
      // you also remove them from .secrets.production.
      "STATIC_STORE_HASH",
      "STATIC_STORE_TOKEN"
    ]
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      // The service should match the "name" of your worker
      "service": "starter-sc-app-next"
    }
  ],
  "images": {
    // Enable image optimization
    // see https://opennext.js.org/cloudflare/howtos/image
    "binding": "IMAGES"
  }
}